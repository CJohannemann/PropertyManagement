# Copy to .env and fill in.
#   cp .env.example .env
#
# TEMPORARY: VITE_SUPABASE_URL points at the VPS's bare IP:port
# (http://15.204.120.16:8090) until a domain is bought — see
# deploy/selfhost/README.md's "Moving to a real domain later". Update this
# when that happens.
#
# VITE_SUPABASE_ANON_KEY is the ANON_KEY value from
# deploy/selfhost/.env on the VPS — safe to put here, it's meant to ship in
# the browser bundle. Never put SERVICE_ROLE_KEY in this file.
VITE_SUPABASE_URL=http://15.204.120.16:8090
VITE_SUPABASE_ANON_KEY=
