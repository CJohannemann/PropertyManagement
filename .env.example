# Copy to .env and fill in.
#   cp .env.example .env
#
# On the VPS, don't do it by hand — these are filled in for you:
#   bash deploy/set-domain.sh   # sets VITE_SUPABASE_URL
#   bash deploy/link-env.sh     # copies ANON_KEY and VAPID_PUBLIC_KEY from the backend .env
#
# Both values are baked into the JavaScript bundle at build time, so
# changing either one requires a rebuild (deploy/deploy.sh) before the
# running site notices.
#
# The app and its API share one origin (see
# deploy/nginx-property-management.conf), so this is just the site's own
# address — not a separate api.* host.
VITE_SUPABASE_URL=https://properties.farmhandmanager.com

# The ANON_KEY from deploy/selfhost/.env. Safe here: it's meant to ship in
# the browser bundle, and row-level security is what actually protects the
# data. Never put SERVICE_ROLE_KEY in this file — it bypasses RLS entirely
# and this file's contents are downloadable by anyone using the site.
VITE_SUPABASE_ANON_KEY=

# The VAPID_PUBLIC_KEY from deploy/selfhost/.env — lets the browser
# subscribe to Web Push. Safe here, same reasoning as the anon key above;
# the matching private key stays server-side and is never in this file.
VITE_VAPID_PUBLIC_KEY=

# Stripe's PUBLISHABLE key (pk_test_… or pk_live_…), from
# https://dashboard.stripe.com/test/apikeys. Publishable keys are designed
# to ship in a browser bundle — they can only start a payment, not read or
# move money. The SECRET key (sk_…) must never appear in this file: it
# lives only in deploy/selfhost/.env, where the payments API reads it.
VITE_STRIPE_PUBLISHABLE_KEY=
