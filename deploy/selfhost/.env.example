# Copy to .env in this same folder and fill in every value.
#
#   cp .env.example .env
#   bash generate-secrets.sh   # fills in the generated secrets automatically

# ------------------------------------------------------------------ URL --
# Where the app is reachable. One origin serves both the site and this API
# (see ../nginx-property-management.conf), so this single value is used for
# GoTrue's API_EXTERNAL_URL, SITE_URL, and redirect allow-list.
#
# It is also what confirmation and password-reset emails link to — set it
# to something the recipient's browser cannot reach and those emails break
# silently, which is a genuinely annoying failure to diagnose.
APP_URL=https://properties.farmhandmanager.com

# ---------------------------------------------------------------- secrets --
# `bash generate-secrets.sh` fills all four of these in for you. If you do
# it by hand instead: POSTGRES_PASSWORD ends up embedded inside connection
# URLs (postgres://authenticator:PASSWORD@...), so it needs -hex, not
# -base64 — base64 can contain /, +, or =, and an unescaped / gets misread
# as a path separator, corrupting the URL.
#   openssl rand -hex 32      # -> POSTGRES_PASSWORD
#   openssl rand -base64 32   # -> JWT_SECRET
POSTGRES_PASSWORD=
JWT_SECRET=

# Minted from JWT_SECRET:
#   node mint-jwt.mjs "<the JWT_SECRET value>" anon
#   node mint-jwt.mjs "<the JWT_SECRET value>" service_role
#
# ANON_KEY is safe to expose in the browser bundle. SERVICE_ROLE_KEY
# bypasses row-level security entirely — it's the key the Stripe webhook
# handler will use to write payments (see db/schema.sql's payments table,
# which deliberately has no client-facing insert policy). Never ship it to
# the frontend or paste it anywhere client-side.
ANON_KEY=
SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ push --
# Web Push (VAPID) — lets deploy/selfhost/send-request-notifications.mjs
# alert an admin/property manager's browser about a new maintenance
# request. `bash generate-secrets.sh` generates the keypair; done by hand
# instead:
#   node generate-vapid-keys.mjs
#
# VAPID_PUBLIC_KEY also needs to reach the frontend build as
# VITE_VAPID_PUBLIC_KEY (see ../link-env.sh) — safe to expose, same as
# ANON_KEY. VAPID_PRIVATE_KEY never leaves this file.
#
# VAPID_SUBJECT is not a secret — it's a contact a push service (Chrome,
# Firefox, etc.) can reach if it needs to flag a problem with how this
# server is sending. A mailto: address, not generated for you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------- Stripe --
# Rent payments. Read by the payments API (server/), which is the only
# thing that ever sees these — they must never reach the browser bundle.
#
# Setup, once:
#   1. Create a Stripe account at https://dashboard.stripe.com/register
#   2. Enable Connect: https://dashboard.stripe.com/connect
#   3. Keys (make sure you are in a sandbox / test mode, not live):
#      https://dashboard.stripe.com/test/apikeys
#   4. Add a webhook endpoint pointing at
#        https://<your domain>/api/stripe/webhook
#      listening for at least:
#        payment_intent.processing, payment_intent.succeeded,
#        payment_intent.payment_failed, charge.dispute.created,
#        charge.refunded, account.updated
#      Tick "listen to events on connected accounts" — rent is charged
#      directly on the landlord's account, so the events originate there,
#      not on the platform account.
#      Its signing secret (whsec_…) is STRIPE_WEBHOOK_SECRET below.
#
# STRIPE_SECRET_KEY starting sk_test_ is a sandbox; sk_live_ moves real
# money. The API logs which mode it started in, loudly, for that reason.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The publishable key (pk_test_… / pk_live_…) from the same Dashboard page.
# Kept here so ../link-env.sh can copy it into the frontend's .env as
# VITE_STRIPE_PUBLISHABLE_KEY, the same way it does the anon and VAPID
# keys. Safe to ship in the browser bundle — it can start a payment,
# never read or move money.
STRIPE_PUBLISHABLE_KEY=

# What a tenant is charged on top of the rent when their lease says the
# tenant absorbs the processing fee (leases.fee_payer = 'tenant'). Stripe's
# published ACH price at time of writing: 0.8%, capped at 5 USD. Kept as
# configuration because it is Stripe's number to change, and following them
# shouldn't need a migration.
ACH_FEE_PERCENT=0.008
ACH_FEE_CAP_CENTS=500

# ------------------------------------------------------------------ SMTP --
# REQUIRED. GOTRUE_MAILER_AUTOCONFIRM is "false", so accounts must confirm
# their email — with mail broken, nobody can finish signing up at all.
# Password resets and emailed invites need this too.
#
# The same Brevo account FarmHand already uses works fine here; only
# SMTP_ADMIN_EMAIL and the sender name differ per app.
#   1. Brevo dashboard -> Settings (gear) -> SMTP & API -> SMTP tab for the
#      server/port/login, and an SMTP key (not your account password).
#   2. Settings -> Senders, Domains & Dedicated IPs -> Senders: verify the
#      address in SMTP_ADMIN_EMAIL below — Brevo rejects mail from an
#      unverified sender.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
