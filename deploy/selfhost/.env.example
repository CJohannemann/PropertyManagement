# Copy to .env in this same folder and fill in every value.
#
#   cp .env.example .env

# ------------------------------------------------------------- IP & ports --
# TEMPORARY, until a domain is bought (see README.md's "Moving to a real
# domain later" section). API_HOST/API_PORT is where nginx will publicly
# proxy this stack; FRONTEND_DEV_URL is wherever the frontend actually runs
# during development (Vite's default shown here) — update it once that's
# no longer localhost.
API_HOST=15.204.120.16
API_PORT=8090
FRONTEND_DEV_URL=http://localhost:5173

# ---------------------------------------------------------------- secrets --
# POSTGRES_PASSWORD ends up embedded directly inside connection URLs
# (postgres://authenticator:PASSWORD@...), so it needs -hex, not -base64 —
# base64 can contain /, +, or =, and an unescaped / in particular gets
# misread as a path separator, corrupting the URL. JWT_SECRET is never
# embedded in a URL, so -base64 is fine for it.
#   openssl rand -hex 32      # -> POSTGRES_PASSWORD
#   openssl rand -base64 32   # -> JWT_SECRET
POSTGRES_PASSWORD=
JWT_SECRET=

# Mint these two AFTER filling in JWT_SECRET above, with:
#   node mint-jwt.mjs "<the JWT_SECRET value>" anon
#   node mint-jwt.mjs "<the JWT_SECRET value>" service_role
#
# ANON_KEY is safe to expose in the browser bundle (it's what
# supabase-js is initialized with client-side). SERVICE_ROLE_KEY bypasses
# row-level security entirely — this is the key the Stripe webhook handler
# uses to write payments (see db/schema.sql's payments table comments for
# why that table has no client-facing insert policy). Never ship it to the
# frontend or paste it anywhere client-side.
ANON_KEY=
SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ SMTP --
# Not required yet while GOTRUE_MAILER_AUTOCONFIRM is "true" in
# docker-compose.yml, but fill it in now anyway so flipping that off later
# doesn't also require redeploying this stack. Same Brevo account FarmHand
# already uses works fine here — just a different SMTP_ADMIN_EMAIL/sender
# name if you want emails to look distinct per app.
#   1. Brevo dashboard -> Settings (gear) -> SMTP & API -> SMTP tab for the
#      server/port/login, and an SMTP key (not your account password).
#   2. Settings -> Senders, Domains & Dedicated IPs -> Senders: verify the
#      address you put in SMTP_ADMIN_EMAIL below — Brevo rejects mail from
#      an unverified sender.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
